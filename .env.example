DISCORD_TOKEN=
DISCORD_GUILD_ID=
COMMAND_PREFIX=cat!
# Docker 用 /app/sqlite-data/game.db；本地 Windows 用 sqlite-data/game.db
DB_PATH=/app/sqlite-data/game.db
# 本地 Web 服务端口，不填则默认 8080
WEB_PORT=8080
PUBLIC_EVENT_CHANNEL_ID=

# ===== Web 面板访问控制 =====
# 面板会显示每个玩家的 discord_id、作息时间、灵石与背包。
# 设了 WEB_PASS 就启用 HTTP Basic 鉴权；留空则：
#   - 本地/单机运行：不鉴权（方便自己看）
#   - 跑在 Kubernetes 里：面板直接停用（生产不允许无鉴权对外暴露）
# 对公网暴露时**必须**设置，且建议同时在隧道前面加一层（如 Cloudflare Access）。
WEB_USER=admin
WEB_PASS=

# ===== 音乐 / YouTube =====
# PO token 签发服务地址。留空则不启用（本机开发一般不需要）。
# docker-compose 已自动设置；k8s 由 deployment 注入。
POT_PROVIDER_URL=

# ===== Auto update (git pull) =====
# 是否自动更新（启动时检测 + 定时检查）
# 为空/0=关闭；1=true开启
AUTO_UPDATE=0
# 更新间隔（分钟）
UPDATE_INTERVAL_MINUTES=60
# 更新通道：stable=取最新 Release tag(v*) 的提交；alpha=取最新提交（origin/HEAD）
UPDATE_CHANNEL=stable