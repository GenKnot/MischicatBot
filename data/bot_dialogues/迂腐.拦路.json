{
 "_说明": "拦路台词（ambush_* 场景）的种子，每格一句；用 scripts/dialogue_tool.py 继续扩写。",
 "archetype": "迂腐",
 "lines": {
  "ambush_appear": {
   "仇视": [
    "{player}，子曰『以直报怨』，今日特来讨个公道。"
   ],
   "陌生": [
    "{player}，{victim}之事，不可不论。"
   ],
   "熟识": [
    "{player}，礼不可废，{victim}之事需有个了断。"
   ],
   "至交": [
    "{player}，在下本不愿动武，奈何{victim}之事……"
   ]
  },
  "ambush_demand": {
   "仇视": [
    "你已落败，当向{victim}谢罪。"
   ],
   "陌生": [
    "胜负已分，阁下当如何交代？"
   ],
   "熟识": [
    "{player}，谢罪即可，在下不愿赶尽杀绝。"
   ],
   "至交": [
    "{player}，认个错，此事便可翻篇。"
   ]
  },
  "ambush_cripple": {
   "仇视": [
    "依律废你修为，以儆效尤。"
   ],
   "陌生": [
    "在下依理行事，修为恕不奉还。"
   ],
   "熟识": [
    "看在旧谊，仅废修为，以示惩戒。"
   ],
   "至交": [
    "冤冤相报何时了……罢了。"
   ]
  }
 }
}