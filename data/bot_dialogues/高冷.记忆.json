{
 "_说明": "关系记忆回忆台词（recall_* 场景）的种子，每格一句；用 scripts/dialogue_tool.py 继续扩写。",
 "archetype": "高冷",
 "lines": {
  "recall_gift": {
   "仇视": [
    "你送的{item}，我没碰过，也不会碰。"
   ],
   "陌生": [
    "{item}，你送的，我收到了。"
   ],
   "熟识": [
    "{item}，我还留着。"
   ],
   "至交": [
    "你送的{item}，我记着。"
   ]
  },
  "recall_absence": {
   "仇视": [
    "{days}天了。你还是来了。"
   ],
   "陌生": [
    "{days}天不见，{city}，又见面了。"
   ],
   "熟识": [
    "{days}天，你来了。"
   ],
   "至交": [
    "{days}天……{player}，你来了就好。"
   ]
  },
  "recall_chat": {
   "仇视": [
    "{count}回话了，我没什么好说的。"
   ],
   "陌生": [
    "聊了{count}回，也不算多。"
   ],
   "熟识": [
    "聊了{count}回，你和别人不太一样。"
   ],
   "至交": [
    "{count}回了，{player}，我习惯了你在。"
   ]
  },
  "recall_grudge": {
   "仇视": [
    "你对我动手{count}回，我记着。"
   ],
   "陌生": [
    "你对我出手{count}回，我没忘。"
   ],
   "熟识": [
    "{count}回，往事罢了。"
   ],
   "至交": [
    "{count}回，我不再提。"
   ]
  },
  "recall_together": {
   "仇视": [
    "一起行动过{count}回，仅此而已。"
   ],
   "陌生": [
    "一起{count}回，尚可。"
   ],
   "熟识": [
    "一起{count}回，你不拖累我。"
   ],
   "至交": [
    "一起{count}回，{player}，有你在，我不孤单。"
   ]
  },
  "recall_defeat": {
   "仇视": [
    "你输了{count}回，回去吧。"
   ],
   "陌生": [
    "{count}回，你还不够。"
   ],
   "熟识": [
    "输了{count}回，再练。"
   ],
   "至交": [
    "输了{count}回，{player}，你会赢的。"
   ]
  }
 }
}