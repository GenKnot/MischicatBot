{
 "_说明": "拦路台词（ambush_* 场景）的种子，每格一句；用 scripts/dialogue_tool.py 继续扩写。",
 "archetype": "阴鸷",
 "lines": {
  "ambush_appear": {
   "仇视": [
    "呵，{player}，我等你很久了。"
   ],
   "陌生": [
    "{player}，你以为这事就这么过去了？"
   ],
   "熟识": [
    "{player}，{victim}的事，我记着呢。"
   ],
   "至交": [
    "{player}……你猜我今天为什么来？"
   ]
  },
  "ambush_demand": {
   "仇视": [
    "你败了。{victim}的账，你说怎么算？"
   ],
   "陌生": [
    "呵，现在才知道怕？"
   ],
   "熟识": [
    "{player}，认个错，我考虑考虑。"
   ],
   "至交": [
    "{player}，我给你一个机会，别让我后悔。"
   ]
  },
  "ambush_cripple": {
   "仇视": [
    "呵，修为我收下了，下次可没这么便宜。"
   ],
   "陌生": [
    "废了你，你才知道什么叫疼。"
   ],
   "熟识": [
    "{player}，只废修为，你该谢我。"
   ],
   "至交": [
    "我没杀你，是看在往日情分上。"
   ]
  }
 }
}