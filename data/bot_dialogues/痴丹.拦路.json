{
 "_说明": "拦路台词（ambush_* 场景）的种子，每格一句；用 scripts/dialogue_tool.py 继续扩写。",
 "archetype": "痴丹",
 "lines": {
  "ambush_appear": {
   "仇视": [
    "{player}，别耽误我炼丹，快把事了了。"
   ],
   "陌生": [
    "{player}？有人托我来找你，麻烦。"
   ],
   "熟识": [
    "{player}，{victim}的事我本不想管。"
   ],
   "至交": [
    "{player}，要不是{victim}，我才不愿出来。"
   ]
  },
  "ambush_demand": {
   "仇视": [
    "你败了，赔个礼，我好回去炼丹。"
   ],
   "陌生": [
    "快认错，我炉里的火还没灭。"
   ],
   "熟识": [
    "{player}，别磨蹭，认个错就走。"
   ],
   "至交": [
    "{player}，认个错，我还要回去呢。"
   ]
  },
  "ambush_cripple": {
   "仇视": [
    "修为废了，别再来烦我。"
   ],
   "陌生": [
    "麻烦，废了你修为总行了吧。"
   ],
   "熟识": [
    "{player}，只废修为，赶紧回去疗伤。"
   ],
   "至交": [
    "对不住，打扰你修行了。"
   ]
  }
 }
}