{
 "_说明": "星座（只做文案，不影响任何数值）。rules 里的规则可以限定 tiers / scenes。",
 "signs": {
  "白羊": {
   "desc": "冲动直接，想到就说",
   "rules": [
    {
     "punct": {
      "。": "！"
     },
     "punct_p": 0.4,
     "prefix": [
      "来！",
      "喂，"
     ],
     "prefix_p": 0.15
    }
   ]
  },
  "金牛": {
   "desc": "务实，慢热，重实惠",
   "rules": [
    {
     "swap": {
      "东西": "家当",
      "便宜": "实惠"
     },
     "suffix": [
      "慢慢来，不急。"
     ],
     "suffix_p": 0.15
    }
   ]
  },
  "双子": {
   "desc": "思路跳跃，爱插话",
   "rules": [
    {
     "prefix": [
      "说起来，",
      "对了，",
      "哎，"
     ],
     "prefix_p": 0.3,
     "ellipsis_p": 0.2
    }
   ]
  },
  "巨蟹": {
   "desc": "念旧顾家，对亲近的人格外体贴",
   "rules": [
    {
     "suffix": [
      "你多保重。",
      "别累着。",
      "路上当心。"
     ],
     "suffix_p": 0.3,
     "tiers": [
      "熟识",
      "至交"
     ]
    }
   ]
  },
  "狮子": {
   "desc": "骄傲爱面子，说话有派头",
   "rules": [
    {
     "swap": {
      "我": "本人"
     },
     "swap_p": 0.5,
     "punct": {
      "。": "！"
     },
     "punct_p": 0.25,
     "suffix": [
      "不是吗？"
     ],
     "suffix_p": 0.1
    }
   ]
  },
  "处女": {
   "desc": "挑剔细致，爱解释",
   "rules": [
    {
     "suffix": [
      "别见怪，我只是习惯细致些。",
      "这是我的习惯。"
     ],
     "suffix_p": 0.14,
     "end_particles": [
      "吧"
     ],
     "end_p": 0.1
    }
   ]
  },
  "天秤": {
   "desc": "爱权衡，说话留余地",
   "rules": [
    {
     "prefix": [
      "这样吧，",
      "依我看，",
      "说句公道话，"
     ],
     "prefix_p": 0.25
    }
   ]
  },
  "天蝎": {
   "desc": "记仇，认定了就很深",
   "rules": [
    {
     "suffix": [
      "这事，我记着。",
      "我记性好。"
     ],
     "suffix_p": 0.3,
     "tiers": [
      "仇视",
      "陌生"
     ]
    },
    {
     "suffix": [
      "这话只对你说。",
      "你我之间，不必多言。"
     ],
     "suffix_p": 0.22,
     "tiers": [
      "至交"
     ]
    }
   ]
  },
  "射手": {
   "desc": "洒脱爱自由，不拘小节",
   "rules": [
    {
     "prefix": [
      "哈，",
      "走，"
     ],
     "prefix_p": 0.2,
     "punct": {
      "。": "！"
     },
     "punct_p": 0.3
    }
   ]
  },
  "摩羯": {
   "desc": "稳重克制，话少而实",
   "rules": [
    {
     "max_clauses": 2,
     "punct": {
      "！": "。"
     },
     "punct_p": 1.0
    }
   ]
  },
  "水瓶": {
   "desc": "古怪独特，想法与众不同",
   "rules": [
    {
     "prefix": [
      "有意思，",
      "怪了，",
      "奇怪，"
     ],
     "prefix_p": 0.25,
     "ellipsis_p": 0.15
    }
   ]
  },
  "双鱼": {
   "desc": "多愁善感，浪漫",
   "rules": [
    {
     "end_particles": [
      "呢",
      "呀"
     ],
     "end_p": 0.3,
     "ellipsis_p": 0.25
    }
   ]
  }
 }
}