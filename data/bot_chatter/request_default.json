   ]
  },
  {
   "when": {
    "archetype": [
     "高冷"
    ]
   },
   "lines": [
    "……没钱。"
   ]
  },
  {
   "when": {
    "archetype": [
     "贪财"
    ]
   },
   "lines": [
    "{player}，借钱？我怎么不记得有这回事？"
   ]
  },
  {
   "when": {
    "archetype": [
     "阴鸷"
    ]
   },
   "lines": [
    "呵，{player}，你记错了吧。"
   ]
  }
 ]
}