{
 "_说明": "条件化文案库（utils/bot_chatter_lines.py）。失踪调查相关场景。",
 "scene": "investigation_thanks",
 "rules": [
  {
   "lines": [
    "多谢你，{player}，这条线索有用。",
    "{player}，谢谢你告诉我{missing}的事。"
   ]
  },
  {
   "when": {
    "archetype": [
     "豪爽"
    ]
   },
   "lines": [
    "好兄弟！{player}，这条线索太有用了，我欠你一顿酒！"
   ]
  },
  {
   "when": {
    "archetype": [
     "憨直"
    ]
   },
   "lines": [
    "谢谢你，{player}。我会接着找{missing}的。"
   ]
  },
  {
   "when": {
    "archetype": [
     "痴丹"
    ]
   },
   "lines": [
    "哦，{player}，这个消息有用，谢了。"
   ]
  },
  {
   "when": {
    "archetype": [
     "话痨"
    ]
   },
   "lines": [
    "哎呀{player}你太好了！我跟你说我这就去查！"
   ]
  },
  {
   "when": {
    "archetype": [
     "迂腐"
    ]
   },
   "lines": [
    "多谢阁下，此情在下铭记。"
   ]
  },
  {
   "when": {
    "archetype": [
     "高冷"
    ]
   },
   "lines": [
    "……谢了。"
   ]
  },
  {
   "when": {
    "archetype": [
     "贪财"
    ]
   },
   "lines": [
    "{player}，这条线索值钱，我记下了。"
   ]
  },
  {
   "when": {
    "archetype": [
     "阴鸷"
    ]
   },
   "lines": [
    "呵，{player}，你帮了我一个忙。"
   ]
  }
 ]
}